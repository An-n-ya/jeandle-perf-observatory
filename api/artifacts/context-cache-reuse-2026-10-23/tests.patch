@@ -0,0 +1,79 @@
+//===- JavaTypeCacheReuseTest.cpp - Expensive context query reuse tests
+//-----===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "JavaTypeCacheReuseTestSupport.h"
+#include "llvm/IR/Verifier.h"
+#include "gtest/gtest.h"
+
+using namespace llvm;
+using namespace llvm::jeandle::cache_reuse_test;
+
+TEST(JavaTypeCacheReuseTest, DeepSameBlockFinalHitsAvoidOracle) {
+  VMEnvironment Env;
+  Fixture X;
+  ASSERT_FALSE(verifyFunction(*X.F, &errs()));
+  auto *Ctx = X.Contexts.front();
+  auto Cold = X.query(Ctx);
+  ASSERT_EQ(Cold.Klass, 22U);
+  ASSERT_EQ(Cold, X.fresh(Ctx));
+  ASSERT_GT(X.Last.FactsMisses, 32U);
+  ASSERT_GT(X.OracleCalls, 32U);
+  uint64_t Calls = X.OracleCalls;
+  // A different instruction in the same block still has the same context key.
+  for (auto *I : {static_cast<Instruction *>(X.Noise), Ctx}) {
+    EXPECT_EQ(X.query(I), Cold);
+    EXPECT_EQ(X.Last.FinalHits, 1U);
+    EXPECT_EQ(X.Last.FactsMisses, 0U);
+    EXPECT_FALSE(X.Last.SkipVerification);
+    EXPECT_EQ(X.OracleCalls, Calls);
+  }
+}
+
+TEST(JavaTypeCacheReuseTest, DifferentBlocksReuseExpensiveFactsPrefix) {
+  VMEnvironment Env;
+  Fixture X;
+  ASSERT_EQ(X.query(X.Contexts.front()).Klass, 22U);
+  uint64_t ColdMisses = X.Last.FactsMisses;
+  for (unsigned I = 1; I != X.Contexts.size(); ++I) {
+    uint64_t Before = X.OracleCalls;
+    auto T = X.query(X.Contexts[I]);
+    EXPECT_EQ(T, X.fresh(X.Contexts[I]));
+    EXPECT_EQ(T.Klass, 22U);
+    EXPECT_EQ(X.Last.FinalHits, 0U);
+    EXPECT_GT(X.Last.FactsHits, 0U);
+    EXPECT_LT(X.Last.FactsMisses, ColdMisses);
+    EXPECT_EQ(X.OracleCalls - Before, 1U);
+    EXPECT_FALSE(X.Last.SkipVerification);
+  }
+}
+
+TEST(JavaTypeCacheReuseTest, BatchMutationRetainsOrDropsContextCorrectly) {
+  VMEnvironment Env;
+  Fixture X;
+  auto *Ctx = X.Contexts.front();
+  for (unsigned I = 0; I != 16; ++I)
+    ASSERT_EQ(X.query(Ctx).Klass, 22U);
+  ASSERT_GT(X.Cache.finalTypesSize(), 0U);
+  auto Benign = X.editNoise();
+  EXPECT_EQ(Benign.FinalRemoved, 0U);
+  EXPECT_EQ(Benign.FactsRemoved, 0U);
+  uint64_t Calls = X.OracleCalls;
+  for (unsigned I = 0; I != 16; ++I) {
+    EXPECT_EQ(X.query(Ctx), X.fresh(Ctx));
+    EXPECT_EQ(X.Last.FinalHits, 1U);
+    EXPECT_EQ(X.OracleCalls, Calls);
+  }
+  auto Relevant = X.editGuard();
+  EXPECT_GT(Relevant.FinalRemoved, 0U);
+  EXPECT_GT(Relevant.FactsRemoved, 0U);
+  auto After = X.query(Ctx);
+  EXPECT_EQ(After.Klass, 33U);
+  EXPECT_EQ(After, X.fresh(Ctx));
+  EXPECT_EQ(X.Last.FinalHits, 0U);
+  EXPECT_GT(X.Last.FactsMisses, 32U);
+  EXPECT_GT(X.OracleCalls, Calls);
+  EXPECT_EQ(X.query(Ctx), After);
+  EXPECT_EQ(X.Last.FinalHits, 1U);
+  EXPECT_FALSE(verifyFunction(*X.F, &errs()));
+}
diff --git a/llvm/unittests/IR/JavaTypeCacheReuseTestSupport.h b/llvm/unittests/IR/JavaTypeCacheReuseTestSupport.h
new file mode 100644
index 000000000..d8e15d4d6
--- /dev/null
+++ b/llvm/unittests/IR/JavaTypeCacheReuseTestSupport.h
@@ -0,0 +1,148 @@
+//===- JavaTypeCacheReuseTestSupport.h - Context reuse fixtures --*- C++
+//-*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_UNITTESTS_IR_JAVATYPECACHEREUSETESTSUPPORT_H
+#define LLVM_UNITTESTS_IR_JAVATYPECACHEREUSETESTSUPPORT_H
+
+#include "llvm/Analysis/AssumptionCache.h"
+#include "llvm/Analysis/Jeandle/CachedJavaType.h"
+#include "llvm/Analysis/Jeandle/LVINullEdgeOracle.h"
+#include "llvm/Analysis/LazyValueInfo.h"
+#include "llvm/IR/Dominators.h"
+#include "llvm/IR/IRBuilder.h"
+#include "llvm/IR/Jeandle/VMCallback.h"
+#include "llvm/IR/Module.h"
+#include <memory>
+#include <string>
+
+namespace llvm::jeandle::cache_reuse_test {
+struct VMEnvironment {
+  VMCallbacks Saved{};
+  VMEnvironment() {
+    if (const auto *Old = getVMCallbacks())
+      Saved = *Old;
+    VMCallbacks CB{};
+    CB.IsSubtype = [](uintptr_t A, uintptr_t B) { return A == B || B == 1; };
+    CB.IsInterface = [](uintptr_t) { return false; };
+    CB.IsEffectivelyFinal = [](uintptr_t) { return false; };
+    CB.GetSecondarySupers = [](uintptr_t) { return std::vector<uintptr_t>{}; };
+    CB.GetCommonSuperKlass = [](uintptr_t A, uintptr_t B) {
+      return A == B ? A : uintptr_t(1);
+    };
+    registerVMCallbacks(CB);
+  }
+  ~VMEnvironment() { registerVMCallbacks(Saved); }
+};
+
+// No java-klass base attribute: a successful query must recover the guard fact.
+struct Fixture {
+  LLVMContext C;
+  std::unique_ptr<Module> M;
+  Function *F = nullptr;
+  Value *Obj = nullptr;
+  CallInst *Guard = nullptr;
+  BinaryOperator *Noise = nullptr;
+  SmallVector<Instruction *, 16> Contexts;
+  DominatorTree DT;
+  std::unique_ptr<AssumptionCache> AC;
+  std::unique_ptr<LazyValueInfo> LVI;
+  JavaTypeCache Cache;
+  CachedJavaTypeQueryInfo Last;
+  uint64_t OracleCalls = 0;
+  bool CountOracle;
+
+  Constant *klass(unsigned K) {
+    return ConstantExpr::getIntToPtr(ConstantInt::get(Type::getInt64Ty(C), K),
+                                     PointerType::get(C, 0));
+  }
+  Fixture(bool Count = true, unsigned Depth = 32, unsigned Width = 16)
+      : M(std::make_unique<Module>("context-reuse", C)), CountOracle(Count) {
+    auto *Ptr = PointerType::get(C, 0);
+    F = Function::Create(FunctionType::get(Type::getVoidTy(C),
+                                           {Ptr, Type::getInt32Ty(C)}, false),
+                         Function::ExternalLinkage, "test", *M);
+    Obj = F->getArg(0);
+    Obj->setName("obj");
+    auto *Check = Function::Create(
+        FunctionType::get(Type::getInt1Ty(C), {Ptr, Ptr}, false),
+        Function::ExternalLinkage, "jeandle.check_instanceof", *M);
+    Check->addParamAttr(1, Attribute::NonNull);
+    auto *Entry = BasicBlock::Create(C, "entry", F);
+    auto *GuardBB = BasicBlock::Create(C, "guard", F);
+    auto *Fail = BasicBlock::Create(C, "fail", F);
+    SmallVector<BasicBlock *, 64> Blocks;
+    for (unsigned I = 0; I != Depth + Width; ++I)
+      Blocks.push_back(BasicBlock::Create(C, "path" + std::to_string(I), F));
+    BranchInst::Create(GuardBB, Entry);
+    IRBuilder<> B(GuardBB);
+    Guard = B.CreateCall(Check, {klass(22), Obj}, "check");
+    B.CreateCondBr(Guard, Blocks.front(), Fail);
+    ReturnInst::Create(C, Fail);
+    for (unsigned I = 0; I != Blocks.size(); ++I) {
+      if (I + 1 != Blocks.size())
+        BranchInst::Create(Blocks[I + 1], Blocks[I]);
+      else
+        ReturnInst::Create(C, Blocks[I]);
+      if (I >= Depth)
+        Contexts.push_back(Blocks[I]->getTerminator());
+    }
+    Noise = BinaryOperator::CreateAdd(
+        F->getArg(1), ConstantInt::get(Type::getInt32Ty(C), 1), "unrelated",
+        Contexts.front()->getIterator());
+    DT.recalculate(*F);
+    AC = std::make_unique<AssumptionCache>(*F);
+    LVI = std::make_unique<LazyValueInfo>(AC.get(), &M->getDataLayout());
+  }
+  JavaType query(Instruction *Ctx) {
+    LVINullEdgeOracle Oracle{*LVI};
+    if (!CountOracle)
+      return getCachedJavaType(Obj, &DT, Ctx, Oracle, Cache, Last);
+    auto Counted = [&](Value *V, BasicBlock *From, BasicBlock *To) {
+      ++OracleCalls;
+      return Oracle(V, From, To);
+    };
+    return getCachedJavaType(Obj, &DT, Ctx, Counted, Cache, Last);
+  }
+  // A completely fresh dependency set, not the query's warmed DT/LVI/cache.
+  JavaType fresh(Instruction *Ctx) {
+    DominatorTree FreshDT(*F);
+    AssumptionCache FreshAC(*F);
+    LazyValueInfo FreshLVI(&FreshAC, &M->getDataLayout());
+    LVINullEdgeOracle Oracle{FreshLVI};
+    JavaTypeCache FreshCache;
+    CachedJavaTypeQueryInfo Info;
+    return getCachedJavaType(Obj, &FreshDT, Ctx, Oracle, FreshCache, Info);
+  }
+  void reset() {
+    Cache.clear();
+    LVI->clear();
+    Guard->setArgOperand(0, klass(22));
+    Noise->setOperand(1, ConstantInt::get(Type::getInt32Ty(C), 1));
+    OracleCalls = 0;
+  }
+  JavaTypeCacheInvalidationInfo notify(Value *V, bool Full) {
+    if (!Full)
+      return Cache.invalidate({V});
+    JavaTypeCacheInvalidationInfo Info;
+    Info.BaseRemoved = Cache.baseSize();
+    Info.FactsRemoved = Cache.pathFactsSize();
+    Info.FinalRemoved = Cache.finalTypesSize();
+    Info.FullClear = true;
+    Cache.clear();
+    return Info;
+  }
+  JavaTypeCacheInvalidationInfo editNoise(bool Full = false) {
+    auto Info = notify(Noise, Full);
+    Noise->setOperand(1, ConstantInt::get(Type::getInt32Ty(C), 2));
+    return Info;
+  }
+  JavaTypeCacheInvalidationInfo editGuard(bool Full = false) {
+    auto Info = notify(Guard, Full); // Notify while the old use graph is live.
+    Guard->setArgOperand(0, klass(33));
+    LVI->clear(); // CFG is unchanged, but the queried analysis must stay fresh.
+    return Info;
+  }
+};
+} // namespace llvm::jeandle::cache_reuse_test
+#endif
diff --git a/llvm/utils/jeandle/replay-java-type-context-cache.py b/llvm/utils/jeandle/replay-java-type-context-cache.py
new file mode 100644
index 000000000..f1ca01cc3
--- /dev/null
+++ b/llvm/utils/jeandle/replay-java-type-context-cache.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Three paired native replays of expensive JavaType context reuse."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import random
+import statistics
+import subprocess
+
+def sha(path):
+    h = hashlib.sha256()
+    with path.open("rb") as f:
+        for block in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--binary", type=Path, required=True)
+    p.add_argument("--out", type=Path, required=True)
+    p.add_argument("--rounds", type=int, default=3)
+    p.add_argument("--batches", type=int, default=4096)
+    p.add_argument("--cpu", type=int, default=16)
+    a = p.parse_args()
+    if a.rounds < 1 or a.batches < 1:
+        p.error("rounds and batches must be positive")
+    a.out.mkdir(parents=True, exist_ok=False)
+    binary = a.binary.resolve()
+    identity = {"binary": str(binary), "sha256": sha(binary),
+                "rounds": a.rounds, "batches": a.batches, "cpu": a.cpu,
+                "seed": 20261023,
+                "note": "native timer excludes fixture construction; cold clears JavaType only; mutation/full clears on edits; timed oracle counting and fresh verification are disabled"}
+    (a.out / "identity.json").write_text(json.dumps(identity, indent=2))
+    variants = {"final": ["cold", "cached"], "prefix": ["cold", "cached"],
+                "mutation": ["full", "cached"]}
+    def run(case, mode, batches, kind):
+        cmd = ["taskset", "-c", str(a.cpu), str(binary), case, mode,
+               str(batches), kind]
+        r = subprocess.run(cmd, check=True, capture_output=True, text=True)
+        row = json.loads(r.stdout)
+        row["argv"] = cmd
+        return row
+    diag = {}
+    for case, modes in variants.items():
+        diag[case] = {mode: run(case, mode, 1, "diagnostic") for mode in modes}
+        baseline, cached = (diag[case][mode] for mode in modes)
+        assert baseline["checksum"] == cached["checksum"]
+        assert all(x["fresh_reference_checked"] for x in diag[case].values())
+        assert cached["oracle_calls"] < baseline["oracle_calls"]
+    assert diag["final"]["cached"]["final_hits"] == 15
+    assert diag["prefix"]["cached"]["final_hits"] == 0
+    assert diag["prefix"]["cached"]["facts_hits"] == 15
+    assert diag["mutation"]["cached"]["final_hits"] == 46
+    assert diag["mutation"]["full"]["final_hits"] == 45
+    (a.out / "diagnostics.json").write_text(json.dumps(diag, indent=2))
+    rows = []
+    rng = random.Random(20261023)
+    for round_id in range(a.rounds):
+        cases = list(variants)
+        rng.shuffle(cases)
+        for case in cases:
+            modes = list(variants[case])
+            rng.shuffle(modes)
+            for mode in modes:
+                row = run(case, mode, a.batches, "timing")
+                row["round"] = round_id
+                rows.append(row)
+                (a.out / "timings.json").write_text(json.dumps(rows, indent=2))
+        print("completed round", round_id + 1, flush=True)
+    summary = {}
+    for case, modes in variants.items():
+        rr = [r for r in rows if r["scenario"] == case]
+        paired = []
+        for i in range(a.rounds):
+            pair = {r["mode"]: r for r in rr if r["round"] == i}
+            assert pair[modes[0]]["checksum"] == pair["cached"]["checksum"]
+            paired.append(100 * (1 - pair["cached"]["user_s"] /
+                                 pair[modes[0]]["user_s"]))
+        summary[case] = {"baseline_mode": modes[0], "rounds": a.rounds,
+                        "baseline_user_median": statistics.median(r["user_s"] for r in rr if r["mode"] == modes[0]),
+                        "cached_user_median": statistics.median(r["user_s"] for r in rr if r["mode"] == "cached"),
+                        "paired_cpu_reduction_pct_median": statistics.median(paired),
+                        "paired_reductions_pct": paired}
+    assert sha(binary) == identity["sha256"]
+    (a.out / "summary.json").write_text(json.dumps(summary, indent=2))
+    print(json.dumps(summary, indent=2))
+
+if __name__ == "__main__":
+    main()
